# Copy to .env (never commit). All values are placeholders.
# Owner/migration credentials - NOT the Worker's read-only role.
DATABASE_URL=postgresql://seba_owner:CHANGE_ME@127.0.0.1:5432/seba_textbooks

SEBA_CATALOGUE_URL=https://site.sebaonline.org/textbook
DOWNLOAD_DIR=./downloads
MAX_PDF_MB=300
REQUEST_DELAY_SECONDS=1.0

# OCR
OCR_ENABLED=true
OCR_DPI=200
OCR_MIN_CHARS=40

# Embeddings: none | cloudflare | openai | ollama
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=@cf/baai/bge-m3
# cloudflare: needs an API token with Workers AI read/run permission
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# openai-compatible (must return 1024-dim vectors)
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
